generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventMode {
  FIXED_TABLE @map("fixed_table")
  OPEN        @map("open")
}

enum EventStatus {
  UPCOMING @map("upcoming")
  ACTIVE   @map("active")
  ENDED    @map("ended")
}

enum AssignmentMode {
  OPEN     @map("open")
  SPECIFIC @map("specific")
}

enum FacultySelectionLevel {
  FACULTY @map("faculty")
  COURSE  @map("course")
}

enum TableStatus {
  FREE     @map("free")
  OCCUPIED @map("occupied")
}

enum LecturerStatus {
  PENDING  @map("pending")
  ACTIVE   @map("active")
  DISABLED @map("disabled")
}

enum CounterStatus {
  ACTIVE  @map("active")
  AWAY    @map("away")
  OFFLINE @map("offline")
}

enum TicketStatus {
  WAITING @map("waiting")
  SERVING @map("serving")
  DONE    @map("done")
  SKIPPED @map("skipped")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Event {
  id                    String                @id @default(cuid())
  name                  String
  mode                  EventMode
  tableCount            Int?                  @map("table_count")
  tablePrefix           String?               @map("table_prefix")
  ambassadorCode        String                @unique @map("ambassador_code")
  status                EventStatus           @default(UPCOMING)
  assignmentMode        AssignmentMode        @default(OPEN) @map("assignment_mode")
  facultySelectionLevel FacultySelectionLevel @default(COURSE) @map("faculty_selection_level")
  startAt               DateTime              @map("start_at")
  endAt                 DateTime?             @map("end_at")
  createdAt             DateTime              @default(now()) @map("created_at")

  faculties          EventFaculty[]
  tables             EventTable[]
  lecturerFaculties  LecturerFaculty[]
  counters           Counter[]
  queueTickets       QueueTicket[]

  @@index([status])
  @@map("events")
}

model FacultyList {
  id        String  @id @default(cuid())
  name      String
  code      String?
  parentId  String? @map("parent_id")
  isActive  Boolean @default(true) @map("is_active")

  parent             FacultyList?       @relation("FacultyHierarchy", fields: [parentId], references: [id])
  children           FacultyList[]       @relation("FacultyHierarchy")
  eventFaculties     EventFaculty[]
  lecturerFaculties  LecturerFaculty[]
  queueTickets       QueueTicket[]

  @@index([parentId])
  @@map("faculty_list")
}

model EventFaculty {
  id            String @id @default(cuid())
  eventId       String @map("event_id")
  facultyListId String @map("faculty_list_id")
  name          String
  code          String?

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  facultyList FacultyList @relation(fields: [facultyListId], references: [id])
  tables      EventTable[]

  @@unique([eventId, facultyListId])
  @@map("faculties")
}

model EventTable {
  id        String      @id @default(cuid())
  eventId   String      @map("event_id")
  facultyId String?     @map("faculty_id")
  label     String
  status    TableStatus @default(FREE)
  counterId String?     @unique @map("counter_id")

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faculty EventFaculty? @relation(fields: [facultyId], references: [id])
  counter Counter?      @relation(fields: [counterId], references: [id])

  @@unique([eventId, label])
  @@index([eventId, status])
  @@map("tables")
}

model Lecturer {
  id        String         @id @default(cuid())
  name      String?
  email     String         @unique
  status    LecturerStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")

  lecturerFaculties LecturerFaculty[]
  counters          Counter[]

  @@map("lecturers")
}

model LecturerFaculty {
  id            String @id @default(cuid())
  lecturerId    String @map("lecturer_id")
  facultyListId String @map("faculty_list_id")
  eventId       String @map("event_id")

  lecturer    Lecturer    @relation(fields: [lecturerId], references: [id])
  facultyList FacultyList @relation(fields: [facultyListId], references: [id])
  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([lecturerId, facultyListId, eventId])
  @@index([eventId, facultyListId])
  @@map("lecturer_faculties")
}

model Counter {
  id         String        @id @default(cuid())
  eventId    String        @map("event_id")
  lecturerId String        @map("lecturer_id")
  code       String
  status     CounterStatus @default(OFFLINE)

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lecturer     Lecturer      @relation(fields: [lecturerId], references: [id])
  table        EventTable?
  queueTickets QueueTicket[]

  @@unique([eventId, lecturerId])
  @@unique([eventId, code])
  @@index([eventId, status])
  @@map("counters")
}

model QueueTicket {
  id              String       @id @default(cuid())
  eventId         String       @map("event_id")
  counterId       String?      @map("counter_id")
  facultyListId   String       @map("faculty_list_id")
  ticketNumber    String       @map("ticket_number")
  sequenceNumber  Int          @map("sequence_number")
  token           String       @unique
  status          TicketStatus @default(WAITING)
  createdAt       DateTime     @default(now()) @map("created_at")
  servingStartAt  DateTime?    @map("serving_start_at")
  servingEndAt    DateTime?    @map("serving_end_at")

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  counter     Counter?    @relation(fields: [counterId], references: [id])
  facultyList FacultyList @relation(fields: [facultyListId], references: [id])

  @@unique([eventId, ticketNumber])
  @@unique([eventId, facultyListId, sequenceNumber])
  @@index([eventId, status, createdAt])
  @@index([eventId, facultyListId, status, createdAt])
  @@map("queue_tickets")
}
