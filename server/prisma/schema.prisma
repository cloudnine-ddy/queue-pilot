generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  UPCOMING @map("upcoming")
  ACTIVE   @map("active")
  ENDED    @map("ended")
}

enum TicketStatus {
  WAITING @map("waiting")
  CALLED  @map("called")
  DONE    @map("done")
  SKIPPED @map("skipped")
}

model Faculty {
  id       String  @id @default(cuid())
  name     String
  code     String? @unique
  isActive Boolean @default(true) @map("is_active")

  eventFaculties EventFaculty[]
  operators      Operator[]
  queueTickets   QueueTicket[]

  @@map("faculties")
}

model Event {
  id        String      @id @default(cuid())
  name      String
  status    EventStatus @default(UPCOMING)
  startAt   DateTime    @map("start_at")
  endAt     DateTime?   @map("end_at")
  createdAt DateTime    @default(now()) @map("created_at")

  eventFaculties EventFaculty[]
  queueTickets   QueueTicket[]

  @@index([status])
  @@map("events")
}

model EventFaculty {
  id        String @id @default(cuid())
  eventId   String @map("event_id")
  facultyId String @map("faculty_id")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id])

  @@unique([eventId, facultyId])
  @@index([facultyId])
  @@map("event_faculties")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admins")
}

model Operator {
  id           String   @id @default(cuid())
  facultyId    String   @unique @map("faculty_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  faculty Faculty @relation(fields: [facultyId], references: [id])

  @@map("operators")
}

model QueueTicket {
  id             String       @id @default(cuid())
  eventId        String       @map("event_id")
  facultyId      String       @map("faculty_id")
  ticketNumber   String       @map("ticket_number")
  sequenceNumber Int          @map("sequence_number")
  token          String       @unique
  status         TicketStatus @default(WAITING)
  createdAt      DateTime     @default(now()) @map("created_at")
  calledAt       DateTime?    @map("called_at")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id])

  @@unique([eventId, ticketNumber])
  @@unique([eventId, facultyId, sequenceNumber])
  @@index([eventId, status, createdAt])
  @@index([eventId, facultyId, status, createdAt])
  @@map("queue_tickets")
}
